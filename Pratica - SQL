# Treino e testes em SQL

Código:

CREATE TABLE agencia{
	id_agencia INT NOT NULL,
	descricao TEXT NOT NULL,
	gerente	VARCHAR(50),
	status BOOLEAN NOT NULL,
	contato TEXT,
	endereco VARCHAR(100)
};

CREATE TABLE conta{
	id_conta INT NOT NUL,
	id_agencia INT,
	id_tipo_conta VARCAHR(50),
	numero_conta INT,
	decricao TEXT,
	limite INT,
	dias_carencia INT,
	taxa_juros REAL,
	mensalidade REAL
};

ALTER TABLE conta RENAME COLUMN decricao TO descricao;

CREATE TABLE tipo_conta{
	id_tipo_conta INT,
	decricao TEXT
};

CREATE TABLE movimento_conta{
	id_movimento_conta INT,
	id_conta INT,
	data_hora_movimento DATE,
	historico TEXT,
	tipo_movimento VARCAHR(50),
	valor REAL
};

